# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local environments
.venv/
.env
.env.*

# Runtime output
runs/*
!runs/.gitkeep
artifacts/
observations/

# Manual/security-sensitive work products — never publish real target findings
reports/
poc/

# Concrete PoC / 0day exploit code & built binaries — never publish; ship only
# the scaffolding/contract (poc_library/README.md, poc_library/normal/...).
poc_library/xday/
tools/poc_ours_upload/

# Knowledge base: ship only the scaffolding/contract, not the curated entries
knowledge/*.md
!knowledge/README.md
!knowledge/_TEMPLATE.md

# Local scratch
tmp/
*.tmp

# active-tool runtime state
tools/harness/.state/
