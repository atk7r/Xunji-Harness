# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local environments
.venv/
venv/
.env
.env.*

# Runtime output
runs/*
!runs/.gitkeep
# Historical/manual run workbenches sometimes appear at repo root during
# handoff or migration. Keep real target evidence local there too.
/*_20[0-9][0-9][0-9][0-9][0-9][0-9]/
/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_20[0-9][0-9][0-9][0-9][0-9][0-9]/
artifacts/
observations/
review/review_bundle.json

# Local runtime config
config.ini
.claude/settings.local.json
.claude/xunji_active_run
.claude/xunji_active_run.*.tmp
.claude/xunji_session_selections/
.claude/xunji_pending_turns/
.claude/xunji_transition_claims/
.claude/xunji_scope_admission_claims/
.claude/xunji_subagent_stop_ingress/

# Manual/security-sensitive work products — never publish real target findings
reports/
poc/

# Weaponized 0day exploits: ship ONLY the xday/ folder scaffolding; the actual
# exploit code/binaries stay local (operator's call) and are never pushed.
poc_library/xday/*
!poc_library/xday/.gitkeep
tools/poc_ours_upload/

# Normal PoC entries are product-specific by default. Keep all entry directories
# local unless/until disclosure makes a specific entry safe to unignore publicly.
poc_library/normal/*
!poc_library/normal/README.md

# Weaponized knowledge tier: payload/exploit-level entries keyed to recognition.
# Ship ONLY the scaffolding (README + .gitkeep); the actual weaponized entries stay
# local (operator's call) and are never pushed. The public knowledge/ root is the
# grounding tier; weapons live here.
knowledge/weaponized/*
!knowledge/weaponized/.gitkeep
!knowledge/weaponized/README.md

# Egress proxy configs (operator's relay endpoints — local, never pushed)
tools/harness/proxy.conf
tools/harness/codex_proxy.conf

# IP blacklist config (operator's local blocklist — gitignored so it stays local)
tools/harness/ip_blacklist.conf

# Local scratch
tmp/
*.tmp
.DS_Store
# one-off local docx reformatter (hardcoded personal desktop paths)
tools/reformat_docx.ps1
tools/_docx_fmt_config.json

# active-tool runtime state
tools/harness/.state/

# Editor / AI-tool session stores & on-demand OCR resources — local drift, NOT
# Xunji project structure. .kunsdd = an AI-coding tool's chat/thread store;
# tessdata = tesseract OCR data the captcha-solve skill loads on demand (large
# binary, re-downloadable, never belongs in the repo).
.kunsdd/
tessdata/
