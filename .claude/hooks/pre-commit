#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""pre-commit hook: 框架代码修改必须经过异构复审才能提交。

检测 staged 文件中是否有框架代码（tools/ .claude/ docs/ sentinel/），
若有，要求 review/records/ 下存在匹配当前 diff 的复审记录。
无记录 → 拒绝提交，提示 driver 跑异构复审后再提交。

Tier 4（全部不可用）时：driver 手动写 review/records/manual-fallback-<date>.md
记录复审过程。manual-fallback 记录必须包含 "Verdict:" 行、非空内容、staged。

哲学：和 safety_gate 不同——这是流程闸门，FAIL-OPEN（自身异常时放行不卡提交）。
"""

import hashlib
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

FRAMEWORK_DIRS = ["tools/", ".claude/", "docs/", "sentinel/"]


def _git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git"] + list(args), capture_output=True, text=True)


def _repo_root() -> Path | None:
    try:
        r = _git("rev-parse", "--show-toplevel")
        return Path(r.stdout.strip()) if r.returncode == 0 else None
    except Exception:
        return None


def staged_framework_files(repo: Path) -> list[str]:
    r = _git("-C", str(repo), "diff", "--cached", "--name-only")
    files = r.stdout.strip().split("\n") if r.stdout.strip() else []
    return [f for f in files if any(f.startswith(d) for d in FRAMEWORK_DIRS)]


def diff_fingerprint(repo: Path) -> str:
    r = _git("-C", str(repo), "diff", "--cached", "--", *FRAMEWORK_DIRS)
    return hashlib.sha256(r.stdout.encode()).hexdigest()[:16]


def _is_staged_or_committed(repo: Path, f: Path) -> bool:
    """文件必须是 git tracked（staged 或已提交），非 untracked。"""
    r = _git("-C", str(repo), "ls-files", "--error-unmatch", str(f.relative_to(repo)))
    return r.returncode == 0


def _has_approval(text: str) -> bool:
    """复审记录必须包含明确的通过结论。拒绝 BLOCKER/REJECTED 的审查。"""
    import re
    m = re.search(r"(?im)^[#*-]*\s*Verdict\s*[:：]\s*(\S+)", text)
    if not m:
        return False
    verdict = m.group(1).upper().rstrip(".,;:，。；：")
    return verdict in ("PASS", "WARN", "PASSED")


def find_review_record(repo: Path, fp: str) -> Path | None:
    review_dir = repo / "review" / "records"
    if not review_dir.exists():
        return None
    # Sort by mtime (newest first)
    records = sorted(review_dir.glob("*.md"), key=lambda p: p.stat().st_mtime, reverse=True)
    for f in records:
        if not _is_staged_or_committed(repo, f):
            continue
        try:
            text = f.read_text(encoding="utf-8", errors="replace")
        except Exception:
            continue
        # Empty files don't count
        if len(text.strip()) < 20:
            continue
        # Direct fingerprint match: the review covered this exact diff
        if fp in text:
            if _has_approval(text):
                return f
            continue
        # manual-fallback: only accepted if has approval + recent
        if f.name.startswith("manual-fallback-") and _has_approval(text):
            mtime = f.stat().st_mtime
            age_hours = (datetime.now().timestamp() - mtime) / 3600
            if age_hours < 24:
                return f
    return None


def main() -> int:
    repo = _repo_root()
    if not repo:
        return 0  # not in a git repo — nothing to check

    framework_files = staged_framework_files(repo)
    if not framework_files:
        return 0

    fp = diff_fingerprint(repo)
    record = find_review_record(repo, fp)

    if record:
        print(f"[pre-commit] 复审记录: {record.name} — 放行")
        return 0

    # 无复审记录 — 拒绝（不泄露 fingerprint 到错误消息）
    print(f"[pre-commit] BLOCKED: {len(framework_files)} 个框架文件已 staged 但无有效复审记录", file=sys.stderr)
    print(f"[pre-commit]   staged: {', '.join(framework_files[:5])}{'…' if len(framework_files) > 5 else ''}", file=sys.stderr)
    print(f"[pre-commit]", file=sys.stderr)
    print(f"[pre-commit]   提交前必须完成异构复审（Tier 1-3）并记录到 review/records/。", file=sys.stderr)
    print(f"[pre-commit]   复审记录必须: staged + 非空 + Verdict: PASS/WARN。", file=sys.stderr)
    print(f"[pre-commit]   Tier 4 时: review/records/manual-fallback-<date>.md + Verdict: PASS。", file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        print(f"[pre-commit] hook error (fail-open, allowing commit): {e}", file=sys.stderr)
        sys.exit(0)
