.triplet-carousel-container {
  position: relative;
  max-width: 1080px;
  margin: auto;
  overflow: hidden;
  padding: 20px;
}

.triplet-carousel {
  display: flex;
  gap: 20px;
  transition: transform 0.5s ease;
}

.triplet-card {
  flex: 0 0 calc(33.333% - 13.3px);
  border-radius: 20px;
  text-align: center;
  padding: 0px;
  position: relative;
  color: #333;
}


.triplet-card img {
  width: 100%;
  border-radius: 16px 16px 0 0;
}

  .titlefont {
    position: absolute;
    top: 250px;
    font-size: 22px;
    text-align: center;
    font-weight: 500;
  }
  .titlecont {
	color: #373737;
    font-size: 15px;
    display: block;
    width: 85%;
    margin: 0 auto;
    line-height: 26px;
    font-weight: 400;
    padding-top: 20px;
  }
  
   @keyframes iconFadeZoom {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.cardicon {
  position: absolute;
  width: 90px;
  height: 90px;
  background: #fff;
  border-radius: 50%;
  top: 160px;
  left: 35%;
  opacity: 0;
  transform: scale(0.5);
}

.cardicon.animate {
  animation: iconFadeZoom 0.6s ease-out forwards;
  animation-delay: 0.3s;
}
  
  .cardicon img {
    width:45px;
    padding-top:20px;
  }

.triplet-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: #f3f3f3;
  border: none;
  width: 45px;
  height: 45px;
  font-size: 24px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 10;
  color: #777;
}

.triplet-arrow.left {
  left: 0px;
}

.triplet-arrow.right {
  right: 0px;
}

@media (max-width: 820px) {
  .triplet-card {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .triplet-carousel {
    gap: 0;
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    transition: none !important;
    scrollbar-width: none; /* Firefox */
   -ms-overflow-style: none;  /* IE 10+ */
  }

.triplet-carousel::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}

  .triplet-carousel-container {
    padding: 0;
  }
      .et_pb_row {
        width: 90%;}
}
</style>


