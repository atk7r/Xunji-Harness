{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xunji.local/contracts/externally-stopped-agent.v1.schema.json",
  "title": "Xunji Externally Stopped Agent Receipt v1",
  "description": "Content-addressed proof that Claude Code reported one exact started plan-bound non-Reviewer Agent as user-stopped and permanently non-resumable. This projects a failed result for ordinary Reviewer and Root settlement; it is not an Agent return or evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_run",
    "reason",
    "assignment",
    "role",
    "session_id",
    "agent_id",
    "tool_use_id",
    "lane_id",
    "plan_digest",
    "launch_prompt_sha256",
    "launch_event_seq",
    "launch_event_hash",
    "start_event_seq",
    "start_event_hash",
    "observed_head_seq",
    "observed_head_hash",
    "stop_tool_use_id",
    "stop_message",
    "stopped_at",
    "parent_transcript_prefix_length",
    "parent_transcript_prefix_sha256",
    "child_transcript_length",
    "child_transcript_sha256",
    "result_snapshot",
    "recorded_at",
    "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "xunji.externally-stopped-agent.v1"},
    "parent_run": {"type": "string", "minLength": 1, "maxLength": 512},
    "reason": {"const": "claude_client_user_stop_no_resume"},
    "assignment": {
      "type": "string",
      "pattern": "^A-[A-Za-z0-9._-]+$",
      "maxLength": 256
    },
    "role": {
      "enum": [
        "surface", "web-auth", "web-hunter", "code-audit", "exploit",
        "verify", "report"
      ]
    },
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tool_use_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "lane_id": {
      "type": "string",
      "pattern": "^L-[A-Za-z0-9._-]+$",
      "maxLength": 256
    },
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "launch_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "launch_event_seq": {"type": "integer", "minimum": 1},
    "launch_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "start_event_seq": {"type": "integer", "minimum": 1},
    "start_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_head_seq": {"type": "integer", "minimum": 1},
    "observed_head_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stop_tool_use_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "stop_message": {"type": "string", "minLength": 1, "maxLength": 2048},
    "stopped_at": {"$ref": "#/$defs/timestamp"},
    "parent_transcript_prefix_length": {"type": "integer", "minimum": 1},
    "parent_transcript_prefix_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "child_transcript_length": {"type": "integer", "minimum": 1},
    "child_transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_snapshot": {"$ref": "#/$defs/resultSnapshot"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 64
    },
    "resultSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length", "sha256", "missing", "source"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "missing": {"const": false},
        "source": {"const": "external_stop_receipt"}
      }
    }
  }
}
