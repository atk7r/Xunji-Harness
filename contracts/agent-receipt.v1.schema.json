{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xunji.local/contracts/agent-receipt.v1.schema.json",
  "title": "Xunji Plan-bound Agent Attempt Receipt v1",
  "description": "A projected, immutable-runtime-bound attempt. Running attempts carry an explicitly empty result_snapshot; returned and failed attempts carry the exact frozen result metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_run",
    "assignment",
    "attempt_id",
    "lane_id",
    "plan_digest",
    "launch_prompt_sha256",
    "subagent_type",
    "assets",
    "agent_id",
    "tool_use_id",
    "session_id",
    "state",
    "result_snapshot",
    "launched_at"
  ],
  "properties": {
    "schema": {"const": "xunji.agent-receipt.v1"},
    "parent_run": {"type": "string", "minLength": 1, "maxLength": 255},
    "assignment": {"type": "string", "pattern": "^A-[A-Za-z0-9._-]+$", "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "lane_id": {"type": "string", "pattern": "^L-[A-Za-z0-9._-]+$", "maxLength": 256},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "launch_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subagent_type": {"enum": ["xunji-hunter", "xunji-reviewer"]},
    "result_digest_binding": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assets": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 512},
      "uniqueItems": true
    },
    "agent_id": {"type": "string", "maxLength": 1024},
    "tool_use_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "state": {"enum": ["running", "returned", "failed"]},
    "result_snapshot": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "maxProperties": 0},
        {"$ref": "#/$defs/resultSnapshot"}
      ]
    },
    "launched_at": {"$ref": "#/$defs/timestamp"},
    "returned_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"subagent_type": {"const": "xunji-reviewer"}},
        "required": ["subagent_type"]
      },
      "then": {"required": ["result_digest_binding"]},
      "else": {"not": {"required": ["result_digest_binding"]}}
    },
    {
      "if": {"properties": {"state": {"const": "running"}}, "required": ["state"]},
      "then": {
        "properties": {
          "agent_id": {"type": "string", "minLength": 1, "maxLength": 1024},
          "result_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        },
        "not": {"required": ["returned_at"]}
      }
    },
    {
      "if": {"properties": {"state": {"const": "returned"}}, "required": ["state"]},
      "then": {
        "required": ["returned_at"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1, "maxLength": 1024},
          "result_snapshot": {
            "allOf": [
              {"$ref": "#/$defs/resultSnapshot"},
              {
                "properties": {
                  "source": {
                    "enum": [
                      "agent_tool_response",
                      "subagent_stop_response",
                      "transcript_tool_result"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "failed"}}, "required": ["state"]},
      "then": {
        "required": ["returned_at"],
        "properties": {
          "agent_id": {"const": ""},
          "result_snapshot": {
            "allOf": [
              {"$ref": "#/$defs/resultSnapshot"},
              {"properties": {"source": {"const": "agent_failure_response"}}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
      "maxLength": 24
    },
    "resultSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length", "sha256", "missing", "source"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "missing": {"const": false},
        "source": {
          "enum": [
            "agent_tool_response",
            "agent_failure_response",
            "subagent_stop_response",
            "transcript_tool_result"
          ]
        }
      }
    }
  }
}
