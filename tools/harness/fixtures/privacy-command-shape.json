      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "statusline is not a network tool",
      "command": "python3 {ROOT}/tools/xunji_statusline.py --set-active https://example.test/",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "absolute custom sender",
      "command": "/tmp/custom_sender https://target.test/",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "absolute Python custom sender",
      "command": "/usr/bin/python3 custom_sender.py https://target.test/",
