{
  "schema": "xunji.privacy-command-shape.v1",
  "cases": [
    {
      "name": "exact setup target metadata",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target 'https://example.test/path?key=opaque' --date 20260714",
      "shell_control": false,
      "local_setup": true,
      "privacy": "allow"
    },
    {
      "name": "quoted ampersand and semicolon are data",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target 'https://example.test/path?note=a&semi=one;two'",
      "shell_control": false,
      "local_setup": true,
      "privacy": "allow"
    },
    {
      "name": "exact loop source URL metadata",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source 'https://example.test/path?note=a&semi=one;two' --type auto",
      "shell_control": false,
      "local_setup": true,
      "privacy": "allow"
    },
    {
      "name": "exact loop Markdown deterministic normalizer",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source '/tmp/setup source.md' --type file --ai off",
      "shell_control": false,
      "local_setup": true,
      "privacy": "allow"
    },
    {
      "name": "exact loop external normalizer prepare",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source /tmp/source.md --type file --ai external --ai-provider claude-code --ai-model model-v1 --prepare-normalizer",
      "shell_control": false,
      "local_setup": true,
      "privacy": "allow"
    },
    {
      "name": "exact loop external reference candidate",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source /tmp/source.md --type file --ai external --ai-provider claude-code --ai-model model-v1 --candidate-json '{\"schema\":\"setup-normalizer-candidate.v1\",\"request_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"source_sha256\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"redacted_sha256\":\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"target_token\":\"T-0001\",\"asset_tokens\":[],\"entry_tokens\":[],\"scope_refs\":[],\"authorization_refs\":[],\"signal_refs\":[],\"unresolved\":[]}'",
      "shell_control": false,
      "local_setup": true,
      "privacy": "allow"
    },
    {
      "name": "external normalizer missing provider identity",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source /tmp/source.md --ai external --ai-model model-v1 --prepare-normalizer",
      "shell_control": false,
      "local_setup": false,
      "privacy": "allow"
    },
    {
      "name": "candidate is forbidden with AI off",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source /tmp/source.md --ai off --candidate-json '{}' ",
      "shell_control": false,
      "local_setup": false,
      "privacy": "allow"
    },
    {
      "name": "unregistered local AI mode is not exempted",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source /tmp/source.md --ai local",
      "shell_control": false,
      "local_setup": false,
      "privacy": "allow"
    },
    {
      "name": "loop source unknown option",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source https://example.test/ --future yes",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "loop source URL userinfo is never local metadata",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source 'https://user:secret@example.test/' --type url",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "loop source repeated source is ambiguous",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py --source https://example.test/ --source https://other.test/",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "setup unknown option",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target https://example.test/ --future-mode yes",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "setup classify is active egress",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target https://example.test/ --classify",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "compound semicolon",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target https://example.test/ ; python3 custom_sender.py https://target.test/",
      "shell_control": true,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "compound and",
