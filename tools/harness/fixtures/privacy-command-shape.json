      "shell_control": true,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "command substitution",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target $(printf https://example.test/)",
      "shell_control": true,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "backtick substitution",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target `printf https://example.test/`",
      "shell_control": true,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "output redirection",
      "command": "python3 {ROOT}/tools/setup_run.py alpha --target https://example.test/ > setup.log",
      "shell_control": true,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "loop bootstrap is not a network tool",
      "command": "python3 {ROOT}/tools/loop_bootstrap.py alpha https://example.test/recon.json",
      "shell_control": false,
      "local_setup": false,
      "privacy": "deny"
    },
    {
      "name": "loop journal is not a network tool",
